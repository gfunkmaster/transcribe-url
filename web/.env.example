# Copy to .env.local. Only the "Interpret" button needs an LLM; transcription needs no key.
# Set ONE key and that provider is used. Switch provider by switching the key.
ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=        # also set LLM_MODEL
# OPENROUTER_API_KEY=    # also set LLM_MODEL

# If more than one key is set, choose explicitly:
# LLM_PROVIDER=anthropic|deepseek|openai|openrouter|ollama|openai-compatible

# Optional overrides (apply to whichever provider is selected)
# LLM_MODEL=                      # defaults: claude-opus-5-5 (anthropic), deepseek-flash (deepseek)
# LLM_API_KEY=                    # overrides the provider's own key variable
# LLM_BASE_URL=                   # e.g. http://localhost:1234/v1 for LM Studio / vLLM

# Local, no key, nothing leaves your machine:
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.3

# Other
# TRANSCRIBE_OUTDIR=/absolute/path/to/transcripts
# TRANSCRIBE_BIN=/absolute/path/to/transcribe-url.sh
